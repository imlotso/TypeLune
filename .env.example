# 使用 openssl rand -hex 32 生成，并妥善保管；切勿提交真实密钥。
CODE_SECRET=
SITE_DOMAIN=typing.example.com

# 填写已验证的管理员邮箱，注册该邮箱账号后可审核异常成绩。
ADMIN_EMAIL=

# 邮件服务未配置时，游客练习和排行榜可用；注册与邮箱验证码不可用。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 以下为公开构建配置，不要填入密码或密钥。政策内容在 src/data/site-content.ts 维护。
VITE_SITE_OPERATOR=
VITE_SITE_CONTACT_EMAIL=
VITE_PRIVACY_VERSION=
VITE_PRIVACY_EFFECTIVE_DATE=
VITE_TERMS_VERSION=
VITE_TERMS_EFFECTIVE_DATE=
